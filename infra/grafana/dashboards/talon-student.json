          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT class_name AS class, block, teacher_username AS teacher FROM reporting.class_students\n      WHERE student_username = '$student' AND archived_at IS NULL ORDER BY block"
