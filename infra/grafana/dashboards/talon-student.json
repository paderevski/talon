          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT created_at, kind, amount_cents / 100.0 AS amount, job_id AS job, created_by, note\n      FROM reporting.ledger WHERE account_owner = '$student' AND account_kind = 'personal' AND $__timeFilter(created_at)\n      ORDER BY created_at DESC LIMIT 500"
