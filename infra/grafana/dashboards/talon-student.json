    {
      "id": 5,
      "type": "table",
      "title": "Jobs",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "talon-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "talon-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id AS job, status, coalesce(compute_type, 'local') AS machine, created_at AS started, finalized_at AS finished,\n             duration_seconds AS duration, cost_cents / 100.0 AS cost, error, \n  (extract(epoch FROM created_at - interval '10 minutes') * 1000)::bigint AS start_ms,\n  (extract(epoch FROM coalesce(finalized_at, now()) + interval '10 minutes') * 1000)::bigint AS end_ms\n      FROM reporting.jobs WHERE owner_username = '$student' AND $__timeFilter(created_at)\n      ORDER BY created_at DESC LIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open job",
                    "url": "/d/talon-job/talon-job?var-env=$env&var-job_id=${__value.raw}&from=${__data.fields.start_ms}&to=${__data.fields.end_ms}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
