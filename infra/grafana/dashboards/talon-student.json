          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'completed') AS completed, count(*) FILTER (WHERE status = 'failed') AS failed,\n             count(*) FILTER (WHERE status IN ('queued', 'running')) AS unfinished\n      FROM reporting.jobs WHERE owner_username = '$student' AND $__timeFilter(created_at)"
        }
