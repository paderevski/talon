          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(sum(reserved_cents), 0) / 100.0 AS reserved\n      FROM reporting.jobs WHERE status IN ('queued', 'running') AND provider = 'ec2'"
