      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "talon-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT id AS job, status, owner_username AS student, coalesce(compute_type, 'local') AS machine,\n             instance_id AS instance, created_at AS started,\n             extract(epoch FROM now() - created_at)::int AS age,\n             max_runtime_seconds - extract(epoch FROM now() - created_at)::int AS \"time left\",\n             reserved_cents / 100.0 AS reserved,\n             \n  (extract(epoch FROM created_at - interval '10 minutes') * 1000)::bigint AS start_ms,\n  (extract(epoch FROM coalesce(finalized_at, now()) + interval '10 minutes') * 1000)::bigint AS end_ms\n      FROM reporting.jobs\n      WHERE status IN ('queued', 'running')\n      ORDER BY (status = 'running') DESC, created_at\n      LIMIT 100"
        }
      ],
      "description": "Click a job to open its dashboard, or a student. Empty means nothing is running.",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "job"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open job",
                    "url": "/d/talon-job/talon-job?var-env=$env&var-job_id=${__value.raw}&from=${__data.fields.start_ms}&to=${__data.fields.end_ms}"
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "student"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open student",
                    "url": "/d/talon-student/talon-student?var-env=$env&var-student=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "start_ms"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
