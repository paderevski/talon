    {
      "id": 7,
      "type": "table",
      "title": "Running and queued jobs",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
