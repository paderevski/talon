{
  "uid": "talon-web",
  "title": "Talon web server",
  "description": "One web server: metrics and its logs.",
  "tags": [
    "talon"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "demo",
        "current": {
          "text": "demo",
          "value": "demo"
        },
        "options": [
          {
            "text": "demo",
            "value": "demo",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Web server",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "talon-cloudwatch"
        },
        "hide": 0,
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "query": {
          "refId": "VariableQueryEditor-VariableQuery",
          "queryType": "ec2InstanceAttributes",
          "region": "default",
          "attributeName": "InstanceId",
          "ec2Filters": {
            "tag:Project": [
              "talon"
            ],
            "tag:Component": [
              "web"
            ],
            "tag:Environment": [
              "$env"
            ],
            "instance-state-name": [
              "running"
            ]
          }
        }
      }
    ]
  },
  "links": [
    {
      "title": "Talon",
      "type": "dashboards",
      "tags": [
        "talon"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/EC2",
          "metricName": "CPUUtilization",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "statistic": "Average",
          "period": "",
          "matchExact": true,
          "label": "CPU",
          "id": "",
          "expression": ""
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory and disk",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "Talon/Server",
          "metricName": "mem_used_percent",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "statistic": "Average",
          "period": "",
          "matchExact": true,
          "label": "memory",
          "id": "",
          "expression": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "Talon/Server",
          "metricName": "disk_used_percent",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "statistic": "Maximum",
          "period": "",
          "matchExact": true,
          "label": "disk",
          "id": "",
          "expression": ""
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Network",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/EC2",
          "metricName": "NetworkIn",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "statistic": "Sum",
          "period": "",
          "matchExact": true,
          "label": "in",
          "id": "",
          "expression": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/EC2",
          "metricName": "NetworkOut",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "statistic": "Sum",
          "period": "",
          "matchExact": true,
          "label": "out",
          "id": "",
          "expression": ""
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests by status (nginx)",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter @logStream = \"$instance\"\n      | stats count(*) as requests by bin(5m), status",
          "logGroupNames": [
            "/talon/$env/nginx-access"
          ],
          "statsGroups": [
            "status"
          ]
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [],
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Slowest requests (nginx, seconds)",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "filter @logStream = \"$instance\"\n      | stats max(requestTime) as slowest, pct(requestTime, 95) as p95 by bin(5m)",
          "logGroupNames": [
            "/talon/$env/nginx-access"
          ],
          "statsGroups": []
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [],
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Backend warnings and errors",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, level, event, msg, error, requestId, jobId, userId\n      | filter @logStream = \"$instance\" and level in [\"warn\", \"error\"]\n      | sort @timestamp desc\n      | limit 200",
          "logGroupNames": [
            "/talon/$env/backend"
          ],
          "statsGroups": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "requestId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Trace request",
                    "url": "/d/talon-request/talon-request?var-env=$env&var-request_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "jobId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open job",
                    "url": "/d/talon-job/talon-job?var-env=$env&var-job_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "nginx errors",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, @message\n      | filter @logStream = \"$instance\"\n      | sort @timestamp desc\n      | limit 200",
          "logGroupNames": [
            "/talon/$env/nginx-error"
          ],
          "statsGroups": []
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "First boot log",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, @message\n      | filter @logStream = \"$instance\"\n      | sort @timestamp asc\n      | limit 500",
          "logGroupNames": [
            "/talon/$env/bootstrap"
          ],
          "statsGroups": []
        }
      ],
      "description": "Set the time range to include the server's launch.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
