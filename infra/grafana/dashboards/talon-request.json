{
  "uid": "talon-request",
  "title": "Talon request trace",
  "description": "Every backend and nginx line for one request id (the X-Request-Id nginx and the backend share).",
  "tags": [
    "talon"
  ],
  "editable": true,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "custom",
        "query": "demo",
        "current": {
          "text": "demo",
          "value": "demo"
        },
        "options": [
          {
            "text": "demo",
            "value": "demo",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "request_id",
        "label": "Request id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "links": [
    {
      "title": "Talon",
      "type": "dashboards",
      "tags": [
        "talon"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "nginx",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, method, path, status, requestTime, @logStream\n      | filter requestId = \"$request_id\"\n      | sort @timestamp asc",
          "logGroupNames": [
            "/talon/$env/nginx-access"
          ],
          "statsGroups": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "requestTime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "@logStream"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open web server",
                    "url": "/d/talon-web/talon-web?var-env=$env&var-instance=${__value.raw}&${__url_time_range}"
                  }
                ]
              },
              {
                "id": "displayName",
                "value": "server"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Backend",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "talon-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "talon-cloudwatch"
          },
          "queryMode": "Logs",
          "region": "default",
          "id": "",
          "expression": "fields @timestamp, level, event, msg, method, path, status, durationMs, userId, jobId, error\n      | filter requestId = \"$request_id\"\n      | sort @timestamp asc",
          "logGroupNames": [
            "/talon/$env/backend"
          ],
          "statsGroups": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "durationMs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "jobId"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open job",
                    "url": "/d/talon-job/talon-job?var-env=$env&var-job_id=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
