# Copy to terraform.tfvars (gitignored) and fill in.
account_id = "123456789012" # LCPS account this stack may deploy into
owner      = "your-username"
alert_email = "you@example.org" # backup alerts go here (confirm the email AWS sends)

# GitHub App (github.tf), from the app's settings page on github.com.
# github_app_client_id = "Iv23li..."
# github_app_slug      = "talon-aet-cs"
# public_url           = "http://localhost:8080" # later https://talon.lcps.org

# Google Drive connection (google.tf), from the Google Cloud project. The
# client secret goes into SSM by hand (google-oauth-client-secret).
# google_oauth_client_id = "1234-abc.apps.googleusercontent.com"
# google_project_number  = "123456789012"
# google_picker_api_key  = "AIza..."

# Boot CPU jobs from the Image Builder image (image.tf) instead of stock Ubuntu.
# Only after the first build has finished (its SSM parameter must exist).
# cpu_job_image = "baked"
