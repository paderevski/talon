# Copy to backend/.env for local dev (gitignored; `npm run dev` loads it).
# Leave these unset and GitHub sign-in is off: public repos still work.
#
# A dev GitHub App (see README "GitHub App"): callback URL
# http://localhost:5173/api/github/callback, webhooks off,
# Contents: read-only, Metadata: read-only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_SECRET=
# Path to the app's private key (.pem). Keep it outside the repo.
GITHUB_APP_PRIVATE_KEY_FILE=
TALON_PUBLIC_URL=http://localhost:5173
