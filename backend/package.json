{
  "name": "talon-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch \"src\" --watch \"../shared/src\" --ext js,mjs --ignore \"src/data/**\" --ignore \"data/**\" src/server.js",
    "start": "node src/server.js",
    "seed:demo-users": "node scripts/seed-demo-users.mjs",
    "test": "node tests/run.mjs",
    "test:regression": "node tests/run.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed:demo": "node scripts/db-seed-demo.mjs",
    "test:postgres": "node tests/postgres/run.mjs",
    "db:create-admin": "node scripts/db-create-admin.mjs"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "talon-shared": "0.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
